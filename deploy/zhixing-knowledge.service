[Unit]
Description=Zhixing Xiao Dian hybrid knowledge service
After=network-online.target qdrant.service
Wants=network-online.target

[Service]
Type=simple
User=zhixing
WorkingDirectory=/opt/zhixing-knowledge/current
EnvironmentFile=/opt/zhixing-knowledge/knowledge.env
ExecStart=/usr/bin/python3 -m knowledge_service.server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
