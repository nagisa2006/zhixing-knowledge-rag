# Install model weights at these paths; pin exact revisions in the release manifest.
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=8091
KNOWLEDGE_URL=http://127.0.0.1:8091
KNOWLEDGE_API_KEY=REPLACE_WITH_RANDOM_PRIVATE_SECRET
KNOWLEDGE_DB=/opt/zhixing-knowledge/data/knowledge.db
KNOWLEDGE_RAW_DIR=/opt/zhixing-knowledge/data/raw
KNOWLEDGE_QDRANT_URL=http://127.0.0.1:6333

# cpu or cuda. On cpu the reranker parameters below are what keep a query under
# the latency budget; see docs/生产主机算力实测.md for measured numbers.
KNOWLEDGE_MODEL_DEVICE=cpu
KNOWLEDGE_EMBEDDING_MODEL=/opt/zhixing-knowledge/models/bge-m3
KNOWLEDGE_RERANK_MODEL=/opt/zhixing-knowledge/models/bge-reranker-base
KNOWLEDGE_EMBEDDING_REVISION=BAAI/bge-m3@5617a9f61b028005a4858fdac845db406aefb181
KNOWLEDGE_RERANK_REVISION=BAAI/bge-reranker-base@2cfc18c9415c912f9d8155881c133215df768a70

# Rerank cost is linear in candidates x max_length. Defaults measured on 4 CPU
# cores (Intel Icelake): 12 x 256 = 1189 ms, within the 2 s budget with margin.
# 16 x 256 (1576 ms) widens evidence coverage; 8 x 512 (1618 ms) keeps single
# passages intact. Both cost the same time -- pick with acceptance results, not
# by guessing. max_length caps question plus passage together.
KNOWLEDGE_RERANK_CANDIDATES=12
KNOWLEDGE_RERANK_MAX_LENGTH=256
KNOWLEDGE_RERANK_BATCH_SIZE=4
# Leave headroom for the business backend sharing this host. 2 threads roughly
# halves throughput: 12 x 256 becomes 2184 ms and misses the budget.
KNOWLEDGE_TORCH_THREADS=4

# Required, no default. Calibrated against bge-reranker-base revision above with
# the fixed local retrieval cases: 0.45 retains all labeled evidence in the
# current 12-candidate setup. Recalibrate when the reranker or corpus changes.
# The service refuses to start until this is set.
KNOWLEDGE_RERANK_THRESHOLD=0.45

# Bounds the answer context, independent of the rerank truncation above: matched
# passages reach the model with their full content.
KNOWLEDGE_CONTEXT_CHAR_BUDGET=16000
KNOWLEDGE_COMMUNITY_SOURCE_URL=http://127.0.0.1:8080/api/internal/knowledge/community-posts
KNOWLEDGE_COMMUNITY_SOURCE_API_KEY=REPLACE_WITH_BACKEND_KNOWLEDGE_SYNC_API_KEY
KNOWLEDGE_LIBREOFFICE=/usr/bin/soffice
